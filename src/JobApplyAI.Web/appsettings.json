{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cosmos": {
    "AccountEndpoint": "https://<your-cosmos-account>.documents.azure.com:443/",
    "DatabaseName": "JobApplyAI",
    "UserProfilesContainer": "UserProfiles",
    "ResumesContainer": "Resumes",
    "JobPostingsContainer": "JobPostings",
    "JobApplicationsContainer": "JobApplications",
    "CoverLettersContainer": "CoverLetters",
    "InterviewSessionsContainer": "InterviewSessions"
  },
  "AzureAiFoundry": {
    "Endpoint": "https://<your-foundry-or-openai-resource>.openai.azure.com/",
    "ChatDeploymentName": "<your-chat-model-deployment-name>",
    "ApiKey": "",
    "Temperature": 0.4,
    "MaxOutputTokens": 1500
  },
  "EntraExternalId": {
    "Instance": "https://<your-tenant>.ciamlogin.com/",
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-app-registration-client-id>",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Adzuna": {
    "AppId": "<your-adzuna-app-id>",
    "AppKey": "<your-adzuna-app-key>",
    "ResultsPerPage": 20
  },
  "Jooble": {
    "ApiKey": "<your-jooble-api-key>"
  }
}
