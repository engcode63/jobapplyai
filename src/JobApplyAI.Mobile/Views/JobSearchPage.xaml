<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JobApplyAI.Mobile.Views.JobSearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:JobApplyAI.Mobile.ViewModels"
    xmlns:entities="clr-namespace:JobApplyAI.Core.Entities;assembly=JobApplyAI.Core"
    xmlns:enums="clr-namespace:JobApplyAI.Core.Enums;assembly=JobApplyAI.Core"
    x:DataType="vm:JobSearchViewModel"
    Title="Job Search">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="16" RowSpacing="8">
        <Entry Grid.Row="0" Placeholder="Keywords (e.g. software engineer)" Text="{Binding Keywords}" />
        <Entry Grid.Row="1" Placeholder="Location (e.g. Sydney)" Text="{Binding Location}" />
        <Picker Grid.Row="2" Title="Region" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" />
        <Button Grid.Row="3" Text="Search" Command="{Binding SearchCommand}" />
        <Label Grid.Row="4" Text="{Binding StatusMessage}" TextColor="CornflowerBlue" />

        <RefreshView Grid.Row="5" Command="{Binding SearchCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Results}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:JobPosting">
                        <Frame Margin="0,4" Padding="12" BorderColor="LightGray">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Company}" />
                                <Label Text="{Binding Location}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Source, StringFormat='Source: {0}'}" FontSize="12" TextColor="Gray" />
                                <Button Text="Save" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobSearchViewModel}}, Path=SaveCommand}" CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
