<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JobApplyAI.Mobile.Views.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:JobApplyAI.Mobile.ViewModels"
    xmlns:entities="clr-namespace:JobApplyAI.Core.Entities;assembly=JobApplyAI.Core"
    x:DataType="vm:ApplicationsViewModel"
    Title="Applications">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="10">
                <Label Text="{Binding StatusMessage}" TextColor="CornflowerBlue" />

                <Label Text="Saved jobs awaiting application" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding AvailablePostings}" HeightRequest="180">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:JobPosting">
                            <Frame Margin="0,4" Padding="10" BorderColor="LightGray">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding Company}" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Apply"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApplicationsViewModel}}, Path=ApplyCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Your applications" FontAttributes="Bold" Margin="0,10,0,0" />
                <CollectionView ItemsSource="{Binding Applications}">
                    <CollectionView.EmptyView>
                        <Label Text="No applications yet. Save a job and tap Apply above." Margin="0,10,0,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApplicationItem">
                            <Frame Margin="0,4" Padding="12" BorderColor="LightGray">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                    <Label Text="{Binding Company}" FontSize="12" TextColor="Gray" />
                                    <Label Text="{Binding Status}" FontSize="12" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Advance status"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApplicationsViewModel}}, Path=AdvanceStatusCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Tailor resume"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApplicationsViewModel}}, Path=TailorResumeCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Cover letter"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApplicationsViewModel}}, Path=GenerateCoverLetterCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
